/*
 * 本地构建驱动 —— 用于在本机（无 NPU）验证 kernel.asc 的编译与运行。
 *
 * 与平台 main.asc 的区别：
 *   - 平台的 main.asc 只跑一个写死的极小用例，输出二进制供比对
 *   - 本驱动读 `case.txt` 指定的任意 shape，并**打印精确数值**，便于直接判读
 *
 * 本文件是 host 侧程序；kernel.asc 通过 #include 引入（它没有 include guard，
 * 必须恰好包含一次）。
 *
 * 用法：
 *   cmake -DCMAKE_ASC_RUN_MODE=cpu -DCMAKE_ASC_ARCHITECTURES=dav-2201 .. && make -j
 *   ./batch_matmul_max_sum_custom            # 跑 case.txt
 */

#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>
#include <chrono>

#ifdef ASCENDC_CPU_DEBUG
/* CPU 调试模式：ICPU_RUN_KF / GmAlloc / SetKernelMode 都来自这个头。
 * 必须在 #include "kernel.asc" 之前引入 —— kernel.asc 里用到 ICPU_RUN_KF。
 *
 * 注意：CPU 模式下没有 ACL，而 run_kernel 的签名里有 aclrtStream，
 * 故在此提供一个占位类型（CPU 模式下 stream 参数不被使用）。 */
#include "tikicpulib.h"
using aclrtStream = void*;
#else
#include "acl/acl.h"
#endif

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
/* dtype 编码与平台一致 */
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#define ACL_CHECK(expr)                                                     \
    do {                                                                    \
        aclError _r = (expr);                                               \
        if (_r != 0) {                                                      \
            fprintf(stderr, "[ERROR] %s failed at line %d, ret=%d\n",       \
                    #expr, __LINE__, _r);                                   \
            return 1;                                                       \
        }                                                                   \
    } while (0)

#include "kernel.asc"

namespace {

/* --------------------------------------------------------------- fp16 转换 */

/* 把 fp16 位模式转 float。只支持规格化数与 0，够本驱动用。 */
float HalfToFloat(uint16_t h)
{
    const uint32_t sign = static_cast<uint32_t>(h & 0x8000u) << 16;
    const uint32_t exp = (h >> 10) & 0x1Fu;
    const uint32_t man = h & 0x3FFu;
    uint32_t bits;
    if (exp == 0) {
        bits = sign;                                   /* ±0 / 次正规按 0 处理 */
    } else if (exp == 31) {
        bits = sign | 0x7F800000u | (man << 13);       /* inf / nan */
    } else {
        bits = sign | ((exp - 15 + 127) << 23) | (man << 13);
    }
    float f;
    std::memcpy(&f, &bits, sizeof(f));
    return f;
}

/*
 * 把本驱动的 [−1,1) 步长 1/256 的值编码成 fp16 位模式。
 * 这些值在 fp16 下可精确表示（|值| ≤ 1，步长 2^-8，尾数需 8 位，fp16 有 10 位）。
 */
uint16_t HalfBits(float v)
{
    /* 用 float 位模式推导：v = m * 2^-8，|m| ≤ 256 */
    uint32_t bits;
    std::memcpy(&bits, &v, sizeof(bits));
    const uint32_t sign = (bits >> 16) & 0x8000u;
    const int32_t e = static_cast<int32_t>((bits >> 23) & 0xFFu) - 127;
    const uint32_t m = (bits & 0x7FFFFFu) | 0x800000u;      /* 含隐含 1 */
    if (e < -24) {
        return static_cast<uint16_t>(sign);
    }
    /* fp16: exp16 = e + 15, 尾数取高 10 位 */
    const int32_t exp16 = e + 15;
    if (exp16 <= 0) {
        return static_cast<uint16_t>(sign);
    }
    const uint32_t man16 = (m >> 13) & 0x3FFu;
    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(exp16) << 10) | man16);
}

/* ------------------------------------------------------------ 极简数据生成 */

/*
 * 用确定性的伪随机数填充，便于复现。
 * 只依赖整数运算，避免平台/编译器差异。
 */
struct Rng {
    uint64_t s;
    explicit Rng(uint64_t seed) : s(seed ? seed : 1) {}
    uint32_t next() {
        s ^= s << 13; s ^= s >> 7; s ^= s << 17;
        return static_cast<uint32_t>(s >> 32);
    }
    /* [-1, 1) 的 fp16 可精确表示值：用 1/256 为步长 */
    float nextSmall() {
        const int32_t q = static_cast<int32_t>(next() % 513) - 256;   /* [-256,256] */
        return static_cast<float>(q) / 256.0f;
    }
};

/*
 * 按逻辑 (B, M, K) 生成 x1 的 storage 布局：
 *   transposeX1=false -> (B, M, K)
 *   transposeX1=true  -> (B, K, M)
 * 用同一个逻辑值序列，故两种布局只是元素位置不同。
 */
void FillX1(std::vector<uint16_t>& buf, int32_t B, int32_t M, int32_t K,
            bool tX1, Rng& rng)
{
    buf.assign(static_cast<size_t>(B) * M * K, 0);
    for (int32_t b = 0; b < B; ++b) {
        for (int32_t m = 0; m < M; ++m) {
            for (int32_t k = 0; k < K; ++k) {
                const int64_t idx = tX1
                    ? (static_cast<int64_t>(b) * K * M + static_cast<int64_t>(k) * M + m)
                    : (static_cast<int64_t>(b) * M * K + static_cast<int64_t>(m) * K + k);
                buf[static_cast<size_t>(idx)] = HalfBits(rng.nextSmall());
            }
        }
    }
}

void FillX2(std::vector<uint16_t>& buf, int32_t B, int32_t N, int32_t K,
            bool tX2, Rng& rng)
{
    buf.assign(static_cast<size_t>(B) * N * K, 0);
    for (int32_t b = 0; b < B; ++b) {
        for (int32_t n = 0; n < N; ++n) {
            for (int32_t k = 0; k < K; ++k) {
                const int64_t idx = tX2
                    ? (static_cast<int64_t>(b) * N * K + static_cast<int64_t>(n) * K + k)
                    : (static_cast<int64_t>(b) * K * N + static_cast<int64_t>(k) * N + n);
                buf[static_cast<size_t>(idx)] = HalfBits(rng.nextSmall());
            }
        }
    }
}

/* --------------------------------------------------------------- bf16 转换 */

/*
 * bfloat16 是 1+8+7 位：与 fp32 的 1+8+23 位只差尾数宽度，
 * 故 bf16 -> fp32 只需左移 16 位（低位补 0）。
 * 这与 fp16 的 1+5+10 位完全不同 —— 两者不可混用同一套位拆分。
 */
float Bf16ToFloatHost(uint16_t b)
{
    uint32_t bits = static_cast<uint32_t>(b) << 16;
    float f;
    std::memcpy(&f, &bits, sizeof(f));
    return f;
}

/* 把 [-1,1) 步长 1/256 的值编码成 bf16（该范围内可精确表示） */
uint16_t Bf16Bits(float v)
{
    uint32_t bits;
    std::memcpy(&bits, &v, sizeof(bits));
    return static_cast<uint16_t>(bits >> 16);
}

/* ------------------------------------------------------------ 参考实现 */

/*
 * 独立于 kernel 的参考计算（FP64），用于判定输出的对错。
 * 这是本驱动的"裁判"，故刻意不复用 kernel 里的任何辅助函数。
 */
double ReferenceOne(const std::vector<uint16_t>& x1, const std::vector<uint16_t>& x2,
                    int32_t M, int32_t N, int32_t K,
                    bool tX1, bool tX2, int32_t b, bool isBf16, bool isFp32 = false,
                    const std::vector<float>* f1 = nullptr,
                    const std::vector<float>* f2 = nullptr)
{
    if (isFp32 && f1 != nullptr && f2 != nullptr) {
        /* fp32：直接按 float 计算 */
        double sum = 0.0;
        for (int32_t m = 0; m < M; ++m) {
            double best = -1.0e300;
            for (int32_t n = 0; n < N; ++n) {
                double dot = 0.0;
                for (int32_t k = 0; k < K; ++k) {
                    const int64_t i1 = tX1
                        ? (static_cast<int64_t>(b) * K * M + static_cast<int64_t>(k) * M + m)
                        : (static_cast<int64_t>(b) * M * K + static_cast<int64_t>(m) * K + k);
                    const int64_t i2 = tX2
                        ? (static_cast<int64_t>(b) * N * K + static_cast<int64_t>(n) * K + k)
                        : (static_cast<int64_t>(b) * K * N + static_cast<int64_t>(k) * N + n);
                    dot += static_cast<double>((*f1)[static_cast<size_t>(i1)]) *
                           static_cast<double>((*f2)[static_cast<size_t>(i2)]);
                }
                if (dot > best) { best = dot; }
            }
            sum += best;
        }
        return sum;
    }
    const auto dec = [isBf16](uint16_t h) -> double {
        return static_cast<double>(isBf16 ? Bf16ToFloatHost(h) : HalfToFloat(h));
    };
    double sum = 0.0;
    for (int32_t m = 0; m < M; ++m) {
        double best = -1.0e300;
        for (int32_t n = 0; n < N; ++n) {
            double dot = 0.0;
            for (int32_t k = 0; k < K; ++k) {
                const int64_t i1 = tX1
                    ? (static_cast<int64_t>(b) * K * M + static_cast<int64_t>(k) * M + m)
                    : (static_cast<int64_t>(b) * M * K + static_cast<int64_t>(m) * K + k);
                const int64_t i2 = tX2
                    ? (static_cast<int64_t>(b) * N * K + static_cast<int64_t>(n) * K + k)
                    : (static_cast<int64_t>(b) * K * N + static_cast<int64_t>(k) * N + n);
                dot += dec(x1[static_cast<size_t>(i1)]) * dec(x2[static_cast<size_t>(i2)]);
            }
            if (dot > best) { best = dot; }
        }
        sum += best;
    }
    return sum;
}

}  // namespace

int main(int argc, char** argv)
{
    /* ---- 用例参数：命令行可覆盖，默认用平台本地用例 ---- */
    int32_t B = 1, M = 1, N = 1, K = 32;
    int tX1 = 0, tX2 = 0, isBf16 = 0, isFp32 = 0;
    if (argc >= 6) {
        B = std::atoi(argv[1]); M = std::atoi(argv[2]);
        N = std::atoi(argv[3]); K = std::atoi(argv[4]);
        tX1 = std::atoi(argv[5]);
    }
    if (argc >= 7) { tX2 = std::atoi(argv[6]); }
    if (argc >= 8) { isBf16 = std::atoi(argv[7]); }   /* 0=fp16, 1=bf16 */
    if (argc >= 9) { isFp32 = std::atoi(argv[8]); }   /* 1 = fp32 输入 */
    const int skipRef = (argc >= 10) ? std::atoi(argv[9]) : 0;  /* 1 = 跳过参考计算 */

    printf("[case] B=%d M=%d N=%d K=%d transposeX1=%d transposeX2=%d dtype=%s\n",
           B, M, N, K, tX1, tX2, isBf16 ? "bf16" : "fp16");

    /* ---- 生成输入 ---- */
    Rng rng(12345);
    std::vector<uint16_t> h1, h2;
    FillX1(h1, B, M, K, tX1 != 0, rng);
    FillX2(h2, B, N, K, tX2 != 0, rng);
    /* bf16 与 fp16 的位布局不同，故按 dtype 重新编码同一批逻辑值 */
    if (isBf16) {
        for (auto& v : h1) { v = Bf16Bits(HalfToFloat(v)); }
        for (auto& v : h2) { v = Bf16Bits(HalfToFloat(v)); }
    }

    const size_t elemBytes = isFp32 ? sizeof(float) : sizeof(uint16_t);
    const size_t bytes1 = h1.size() * elemBytes;
    const size_t bytes2 = h2.size() * elemBytes;
    const size_t bytesY = static_cast<size_t>(B) * sizeof(float);
    std::vector<float> y(static_cast<size_t>(B), 0.0f);

    /* 按 transpose 标志构造 storage shape */
    int64_t shapeX1[3], shapeX2[3], shapeY[1];
    if (tX1) { shapeX1[0] = B; shapeX1[1] = K; shapeX1[2] = M; }
    else     { shapeX1[0] = B; shapeX1[1] = M; shapeX1[2] = K; }
    if (tX2) { shapeX2[0] = B; shapeX2[1] = N; shapeX2[2] = K; }
    else     { shapeX2[0] = B; shapeX2[1] = K; shapeX2[2] = N; }
    shapeY[0] = B;

    const int32_t dtCode = isFp32 ? 0 : (isBf16 ? 2 : 1);

    /* fp32 模式下把 16 位缓冲按 float 重排（逻辑值不变，只改存储宽度）。
     * 放在条件编译之外，因为参考实现与设备侧都要用。 */
    std::vector<float> f1, f2;
    if (isFp32) {
        f1.resize(h1.size());
        f2.resize(h2.size());
        for (size_t i = 0; i < h1.size(); ++i) {
            f1[i] = static_cast<float>(HalfToFloat(h1[i]));
        }
        for (size_t i = 0; i < h2.size(); ++i) {
            f2[i] = static_cast<float>(HalfToFloat(h2[i]));
        }
    }

#ifdef ASCENDC_CPU_DEBUG
    /* ---------------- CPU 调试模式（官方文档 ICPU_RUN_KF.md 的步骤） ----------------
     * 用 GmAlloc 分配共享内存，用 SetKernelMode 指定核类型，没有 ACL 运行时。 */
    uint8_t* d1 = (uint8_t*)AscendC::GmAlloc(bytes1);
    uint8_t* d2 = (uint8_t*)AscendC::GmAlloc(bytes2);
    uint8_t* dy = (uint8_t*)AscendC::GmAlloc(bytesY);
    if (d1 == nullptr || d2 == nullptr || dy == nullptr) {
        fprintf(stderr, "[ERROR] GmAlloc 失败\n");
        return 1;
    }
    std::memcpy(d1, isFp32 ? (const void*)f1.data() : (const void*)h1.data(), bytes1);
    std::memcpy(d2, isFp32 ? (const void*)f2.data() : (const void*)h2.data(), bytes2);

    int64_t availableCoreNum = 4;

    TensorInfo ti1c[1] = {{shapeX1, 3, dtCode}};
    TensorInfo ti2c[1] = {{shapeX2, 3, dtCode}};
    TensorInfo tiyc[1] = {{shapeY, 1, 0}};
    TensorGroupInfo g1c = {ti1c, 1};
    TensorGroupInfo g2c = {ti2c, 1};
    TensorGroupInfo gyc = {tiyc, 1};

    /* 本算子是纯向量实现，须把内核模式设为 AIV */
    AscendC::SetKernelMode(KernelMode::AIV_MODE);

    const auto tK0 = std::chrono::steady_clock::now();
    run_kernel((GM_ADDR)d1, g1c, (GM_ADDR)d2, g2c, (GM_ADDR)dy, gyc,
               availableCoreNum, nullptr, tX1 != 0, tX2 != 0);
    const auto tK1 = std::chrono::steady_clock::now();

    std::memcpy(y.data(), dy, bytesY);
    AscendC::GmFree((void*)d1);
    AscendC::GmFree((void*)d2);
    AscendC::GmFree((void*)dy);
#else
    /* ---------------- 生产模式：ACL 运行时 ---------------- */
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t availableCoreNum = 4;
    (void)aclrtGetDeviceInfo(0, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum);
    if (availableCoreNum <= 0) { availableCoreNum = 4; }
    printf("[env] availableCoreNum=%ld\n", static_cast<long>(availableCoreNum));

    uint8_t *d1 = nullptr, *d2 = nullptr, *dy = nullptr;
    ACL_CHECK(aclrtMalloc((void**)&d1, bytes1, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&d2, bytes2, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dy, bytesY, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(d1, bytes1, h1.data(), bytes1, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(d2, bytes2, h2.data(), bytes2, ACL_MEMCPY_HOST_TO_DEVICE));

    TensorInfo ti1[1] = {{shapeX1, 3, dtCode}};   /* 1=fp16, 2=bf16 */
    TensorInfo ti2[1] = {{shapeX2, 3, dtCode}};
    TensorInfo tiy[1] = {{shapeY, 1, 0}};       /* 0 = fp32 */
    TensorGroupInfo g1 = {ti1, 1};
    TensorGroupInfo g2 = {ti2, 1};
    TensorGroupInfo gy = {tiy, 1};

    const auto tK0 = std::chrono::steady_clock::now();
    run_kernel((GM_ADDR)d1, g1, (GM_ADDR)d2, g2, (GM_ADDR)dy, gy,
               availableCoreNum, stream, tX1 != 0, tX2 != 0);
    const auto tK1 = std::chrono::steady_clock::now();

    const int syncRet = aclrtSynchronizeStreamWithTimeout(stream, 300000);
    if (syncRet != 0) {
        fprintf(stderr, "[ERROR] 同步失败 ret=%d（kernel 可能崩了）\n", syncRet);
        return 1;
    }
    ACL_CHECK(aclrtMemcpy(y.data(), bytesY, dy, bytesY, ACL_MEMCPY_DEVICE_TO_HOST));

    aclrtFree(d1); aclrtFree(d2); aclrtFree(dy);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
#endif

    /* ---- 计时分离：kernel 单独计时，参考计算单独计时 ---- */
    const auto tR0 = std::chrono::steady_clock::now();

    /* ---- 判读 ---- */

    if (skipRef) {
        printf("[timing] kernel = %lld ms（已跳过参考计算）\n",
               static_cast<long long>(
                   std::chrono::duration_cast<std::chrono::milliseconds>(tK1 - tK0).count()));
        return 0;
    }

    int bad = 0;
    for (int32_t b = 0; b < B; ++b) {
        const double want = ReferenceOne(h1, h2, M, N, K, tX1 != 0, tX2 != 0, b, isBf16 != 0, isFp32 != 0, &f1, &f2);
        const double got = static_cast<double>(y[static_cast<size_t>(b)]);
        const double tol = 1e-3 + 1e-3 * std::fabs(want);
        const bool ok = std::fabs(got - want) <= tol;
        if (!ok) { ++bad; }
        printf("  y[%d] = %.6f   参考 = %.6f   %s\n",
               b, got, want, ok ? "OK" : "**不符**");
    }
    const auto tR1 = std::chrono::steady_clock::now();
    printf("[timing] kernel = %lld ms ; 参考计算 = %lld ms\n",
           static_cast<long long>(
               std::chrono::duration_cast<std::chrono::milliseconds>(tK1 - tK0).count()),
           static_cast<long long>(
               std::chrono::duration_cast<std::chrono::milliseconds>(tR1 - tR0).count()));
    printf("[result] %s（%d/%d 通过）\n", bad == 0 ? "PASS" : "FAIL", B - bad, B);
    return bad == 0 ? 0 : 1;
}
