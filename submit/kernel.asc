/*
 * BatchMatmulMaxSum Kernel — Ascend C Direct Invocation
 *
 * This file is #included by main.asc — do NOT add main(), #pragma once,
 * or include guards.
 *
 * ============================================================================
 * 本文件当前是「最小可编译版本」，不是最终实现。
 *
 * 目的：让平台**编译并运行**一次，从而暴露编译期与平台侧的未知项，
 * 把它们与算法错误隔离开。本版本**刻意不产生正确结果**（y 里写的是探测值），
 * 故平台比对必然失败——这是有意的，不是缺陷。
 *
 * **限定符的关键更正**：模板注释建议 `__cube__`，但那是纯 Cube 的写法。
 * 本算子是 Cube+Vector 混合（Matmul 在 AIC、逐行归约在 AIV），官方同类示例
 * （v9.0.0 的 bare_mix.asc，结构同为"AIC 算 Matmul → AIV 做向量计算"）用的是：
 *
 *     extern "C" __global__ __mix__(1, 2) void kernel(...)
 *     {
 *         if ASCEND_IS_AIC { ... }     // Matmul 计算
 *         if ASCEND_IS_AIV { ... }     // 向量计算
 *     }
 *
 * 并且跨核传递数据时必须用 CrossCoreSetFlag / CrossCoreWaitFlag 同步，
 * 否则 AIV 会读到 AIC 尚未写完的数据。本版本据此改写。
 *
 * 要确认的项：
 *   - __mix__(1, 2) 是否被目标 CANN 9.0.0 接受
 *   - ASCEND_IS_AIV / ASCEND_IS_AIC 分支是否按预期生效
 *   - TensorInfo 的 shape 能否在 device 侧按预期读到（B/M/N/K）
 *   - <<<>>> 启动语法、blockNum 传参、结构体按值传参
 *   - host 侧 tiling API 呼通
 *
 * **平台禁止在提交代码中留下调试输出**（提交时会被判为"不合规内容"，
 * 提示"如需 Debug 请在本地进行"），故**不使用 printf**。
 * 取回信息的唯一通道是 y[0]：按位置编码写入多个探测值（见 kProbe* 常量）。
 *
 * y 只写 1 个 float 是硬约束，不是保守选择：main.asc 给 y 的设备缓冲区只分配
 * 4 字节，且每个测试点的 B 都是 1。故搬运用 DataCopyPad（blockLen 以字节计），
 * 用普通 DataCopy 会按 32 字节块写、直接越界。
 * ============================================================================
 */

#include <cmath>
#include "kernel_operator.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"
#include "kernel_tiling/kernel_tiling.h"

namespace {

/* ------------------------------------------------------------------ 常量 */

constexpr int32_t kDtypeFp16 = 1;
constexpr int32_t kDtypeBf16 = 2;

/*
 * 探测结果的编码与输出方式。
 *
 * 本版本刻意不产生正确结果（y 里写的是探测值），故平台比对必然失败。
 * 这是有意的：目的不是得分，而是让平台**编译并运行**本版本，
 * 从而暴露编译期与平台侧的未知项。
 *
 * 两条取回信息的路径，互为备份：
 *   1. y[0..7] 写入 8 个探测值 —— 平台输出可能带哈希校验和，可反查
 *   2. AscendC::printf 打印同样的值 —— 平台若返回 stdout 则直接可读
 *
 * 每个探测值都刻意落在 float32 可精确表示的范围（< 2^24），不含进位。

 */
/*
 * 探测值的位置编码。
 *
 * printf 不可用，而 y 只能写 1 个 float，故把多个探测值按**位置**编码进一个数：
 *
 *     code = B*16^5 + blockNum*16^4 + dtype*16^3 + match*16^2 + (infoB & 0xFF)*16
 *
 * 16^6 = 2^24，故 B < 16 时整个码值 < 2^24，float32 可**精确**表示（无进位误差）。
 * 各项都能从码值里原样取出：
 *
 *     B        = code // 16^5
 *     blockNum = (code // 16^4) % 16
 *     dtype    = (code // 16^3) % 16
 *     match    = (code // 16^2) % 16     // 1 表示 device 读到的 B 与 host 一致
 *     infoB    = (code // 16) % 256
 *
 * 注意 B 的编码上限是 15（本版本局限）；完整实现不做此编码，只写真实结果。
 */
constexpr int32_t kProbeShiftB        = 5;
constexpr int32_t kProbeShiftBlockNum = 4;
constexpr int32_t kProbeShiftDtype    = 3;
constexpr int32_t kProbeShiftMatch    = 2;
constexpr int32_t kProbeShiftInfoB    = 1;

/*
 * 写回 y 的元素个数是 1。
 *
 * **这是硬约束**：main.asc 给 y 的设备缓冲区只分配了 4 字节
 * （`aclrtMalloc((void**)&outputDevice_y, 4, ...)`），且 y 的 shape 是 (B,)
 * 而每个测试点的 B 都是 1。写多个 float 会越界。
 *
 * 故搬运必须用 DataCopyPad + DataCopyExtParams（blockLen 以**字节**计），
 * 而不能用普通 DataCopy（blockLen 以 32 字节块计）——后者写 1 个 float
 * 也会搬 32 字节，同样越界。
 */
constexpr int32_t kWritebackCount = 1;

/* ------------------------------------------------- 设备侧：最小 device kernel */

/*
 * 参数含 TensorGroupInfo / TensorInfo —— 按值传参，与最终设计一致。
 * 这里刻意读一次 info 的成员：若编译通过，说明该结构在 device 侧可用。
 *
 * 写回路径用 UB -> GM 的 DataCopy（而非 GlobalTensor::SetValue），原因有两条：
 *   1. DataCopy 是官方文档中设备侧写 GM 的标准路径，最终实现也要用它
 *   2. GlobalTensor::SetValue 在 devkit 中**声明与实现的签名不一致**
 *      （头文件是 `uint32_t index` + 模板参数 S，impl 是 `uint64_t offset`
 *      + PrimType），逐个标量写 GM 有编译风险，不值得在本阶段承担
 */
extern "C" __global__ __mix__(1, 2) void batch_matmul_max_sum_custom(
    __gm__ uint8_t* y,
    TensorGroupInfo info_y,
    int32_t B, int32_t M, int32_t N, int32_t K,
    int32_t dtypeCode)
{
    /* TPipe / TQue 在分支之前声明：官方 bare_mix.asc 即为此形态，
     * 且最终实现里 AIC 侧也要用 pipe 管理 Matmul 的 buffer。 */
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;

    /* 读 info_y 的首维（即 B），与 host 侧推出的 B 交叉验证。
     * TensorInfo 由 host 侧按值传入，此处读其成员——
     * 若编译通过即说明该结构在 device 侧可用。 */
    const int64_t infoB = (info_y.numTensors > 0 && info_y.tensors != nullptr)
                              ? info_y.tensors[0].shape[0]
                              : -1;

    const int32_t blockNum = static_cast<int32_t>(AscendC::GetBlockNum());
    const int32_t blockIdx = static_cast<int32_t>(AscendC::GetBlockIdx());
    const bool matches = (infoB == static_cast<int64_t>(B));

    /* ---- AIC 侧 ---- 最终实现里 Matmul 计算在这里。
     * 本版本 AIC 与 AIV 之间没有数据依赖，故不调用跨核同步。
     * 最终实现**必须**在 Matmul 回写之后调用
     * CrossCoreSetFlag<0x2, PIPE_FIX>(flagId)，并在 AIV 侧
     * CrossCoreWaitFlag(flagId)，否则 AIV 会读到尚未写完的数据。 */
    if ASCEND_IS_AIC {
        return;
    }

    /* ---- AIV 侧 ---- 逐行归约与输出写回。 */
    if ASCEND_IS_AIV {
        if (blockIdx != 0) {
            return;                   /* 只有 0 号核写结果 */
        }

        /* 位置编码写入 y[0]（printf 不可用，这是唯一的取回通道） */
        const int64_t code =
              static_cast<int64_t>(B)                        << (4 * kProbeShiftB)
            + static_cast<int64_t>(blockNum & 0xF)           << (4 * kProbeShiftBlockNum)
            + static_cast<int64_t>(dtypeCode & 0xF)          << (4 * kProbeShiftDtype)
            + static_cast<int64_t>(matches ? 1 : 0)          << (4 * kProbeShiftMatch)
            + static_cast<int64_t>(infoB & 0xFF)             << (4 * kProbeShiftInfoB);
        const float written = static_cast<float>(code);

        pipe.InitBuffer(outQueue, 1,
                        kWritebackCount * static_cast<int32_t>(sizeof(float)));

        AscendC::LocalTensor<float> outLocal = outQueue.AllocTensor<float>();
        outLocal.SetValue(static_cast<uint64_t>(0), written);
        outQueue.EnQue(outLocal);

        AscendC::LocalTensor<float> srcLocal = outQueue.DeQue<float>();
        AscendC::GlobalTensor<float> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), kWritebackCount);
        /* blockLen 以字节计，故只搬 4 字节，不越界 */
        AscendC::DataCopyExtParams copyParams{
            1, static_cast<uint32_t>(kWritebackCount * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yGm, srcLocal, copyParams);
        outQueue.FreeTensor(srcLocal);
    }
}

/* ------------------------------------- 宿主侧：解析 shape、算 tiling、启动 */

/*
 * OQ-013：host 侧用 tiling API 算一份 TCubeTiling，仅验证可用性；
 * 本版本不把结果传给 kernel（避免依赖尚未确认的 tiling 传递机制）。
 * 返回 true 表示 tiling 计算成功。
 */
bool ProbeHostTiling(bool isBf16, bool transA, bool transB,
                     int32_t M, int32_t N, int32_t K, int32_t usedCores)
{
    /* 真实签名：static PlatformAscendC* GetInstance()（另有带 customSocVersion 的重载） */
    const auto* platformMgr = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platformMgr == nullptr) {
        return false;
    }

    matmul_tiling::MultiCoreMatmulTiling tilingApi(*platformMgr);
    const auto mmPos = matmul_tiling::TPosition::GM;
    const auto mmFmt = matmul_tiling::CubeFormat::ND;
    const auto inDtype = isBf16 ? matmul_tiling::DataType::DT_BFLOAT16
                                : matmul_tiling::DataType::DT_FLOAT16;

    tilingApi.SetDim(usedCores);
    tilingApi.SetAType(mmPos, mmFmt, inDtype, transA);
    tilingApi.SetBType(mmPos, mmFmt, inDtype, transB);
    tilingApi.SetCType(mmPos, mmFmt, matmul_tiling::DataType::DT_FLOAT);
    tilingApi.SetBiasType(mmPos, mmFmt, matmul_tiling::DataType::DT_FLOAT);
    tilingApi.SetOrgShape(M, N, K);
    tilingApi.SetShape(M, N, K);
    tilingApi.SetBias(false);

    optiling::TCubeTiling cubeTiling;
    const int64_t ret = tilingApi.GetTiling(cubeTiling);
    return ret != -1;
}

bool Launch(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
            const TensorGroupInfo& info_x1, const TensorGroupInfo& info_x2,
            const TensorGroupInfo& info_y,
            int64_t availableCoreNum, aclrtStream stream,
            bool transposeX1, bool transposeX2,
            bool isBf16)
{
    /* ---- 1. 基本校验 ---- */
    if (info_x1.tensors == nullptr || info_x2.tensors == nullptr ||
        info_y.tensors == nullptr) {
        return false;
    }
    if (info_x1.numTensors != 1 || info_x2.numTensors != 1 || info_y.numTensors != 1) {
        return false;
    }
    if (info_x1.tensors[0].numDims != 3 || info_x2.tensors[0].numDims != 3) {
        return false;
    }

    const int64_t* s1 = info_x1.tensors[0].shape;
    const int64_t* s2 = info_x2.tensors[0].shape;

    /* ---- 2. 按 transpose 标志反推逻辑维度（01 §3）---- */
    const int32_t B = static_cast<int32_t>(s1[0]);
    const int32_t M = static_cast<int32_t>(transposeX1 ? s1[2] : s1[1]);
    const int32_t Ka = static_cast<int32_t>(transposeX1 ? s1[1] : s1[2]);
    const int32_t Kb = static_cast<int32_t>(transposeX2 ? s2[2] : s2[1]);
    const int32_t N = static_cast<int32_t>(transposeX2 ? s2[1] : s2[2]);

    if (B <= 0 || M <= 0 || N <= 0 || Ka != Kb) {
        return false;
    }
    const int32_t dtypeCode = info_x1.tensors[0].dtype;
    if (dtypeCode != kDtypeFp16 && dtypeCode != kDtypeBf16) {
        return false;
    }

    /* ---- 3. 核数与 host 侧 tiling（OQ-013）---- */
    int32_t usedCores = static_cast<int32_t>(availableCoreNum);
    if (usedCores <= 0) {
        usedCores = 1;
    }
    if (usedCores > B) {
        usedCores = B;                /* batch 对齐切分下，核数上限为 B */
    }
    const bool tilingOk = ProbeHostTiling(isBf16, transposeX1, transposeX2,
                                          M, N, Ka, usedCores);

    /* ---- 4. 启动 device kernel ---- */
    const int32_t yDtypeCode =
        tilingOk ? dtypeCode : (dtypeCode + 100);   /* +100 标记 tiling 失败 */

    batch_matmul_max_sum_custom<<<usedCores, 0, stream>>>(
        y, info_y, B, M, N, Ka, yDtypeCode);

    return true;
}

}  // namespace

/* -------------------------------------------------------- 唯一契约入口 */

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y,  const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1,
                           bool transposeX2)
{
    if (info_x1.tensors == nullptr || info_x2.tensors == nullptr) {
        return;
    }
    const int32_t dtypeCode = info_x1.tensors[0].dtype;

    /* dtype 是运行时值，而 kernel 的模板参数是编译期的，故在此分派。
     * 本版本两种 dtype 走同一份实现，分派结构先立起来。 */
    bool ok = false;
    if (dtypeCode == kDtypeFp16) {
        ok = Launch(x1, x2, y, info_x1, info_x2, info_y,
                    availableCoreNum, stream, transposeX1, transposeX2, false);
    } else if (dtypeCode == kDtypeBf16) {
        ok = Launch(x1, x2, y, info_x1, info_x2, info_y,
                    availableCoreNum, stream, transposeX1, transposeX2, true);
    }

    if (!ok) {
        /* 校验未通过：不启动 kernel，直接返回。
         * y 的内容由平台决定，故此时输出不可用 —— 这是刻意的（01 §4）。 */
        return;
    }
}
