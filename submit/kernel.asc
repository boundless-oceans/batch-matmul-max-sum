/*
 * BatchMatmulMaxSum Kernel — Ascend C Direct Invocation
 *
 * This file is #included by main.asc — do NOT add main(), #pragma once,
 * or include guards.
 *
 * ============================================================================
 * 本版本：**纯 Vector 的正确实现**（第一个可提交实现）。
 *
 * ## 为什么先用纯 Vector
 *
 * 本算子理应走 "AIC 算 Matmul + AIV 做归约" 的混合路径，但那需要 __mix__、
 * AIC/AIV 代码隔离、跨核同步（CrossCoreSetFlag/WaitFlag）、Matmul tiling 与
 * REGIST_MATMUL_OBJ —— 未知项多。故第一版用**纯向量**把正确性先锁住，
 * 再迭代换 Cube 提升性能。
 *
 * 向量实现按数学定义直接展开：对每个 (b, m) 行，沿 N 求各列点积的最大值，
 * 再沿 M 求和。复杂度 O(B*M*N*K)，比 Cube 慢，但**不依赖任何跨核机制**，
 * 出错面最小。UB 占用是 O(K)，不随 M/N 增长。
 *
 * ## 两条已验证的硬约束
 *
 * 1. **device kernel 不得解引用宿主指针。** 早先版本把 TensorGroupInfo 按值
 *    传给 kernel 并读 `info.tensors[0].shape`——那是宿主地址，AI Core 解引用
 *    会直接 aicore exception（实测 ret=507015，全部测试点失败）。
 *    故形状在 host 侧解析完毕，kernel 只收纯数值参数。
 *
 * 2. **提交代码不得含调试输出**（printf 等）。平台判为"不合规内容"，
 *    反馈原文"如需 Debug 请在本地进行"。
 *
 * ## 数值约定
 *
 * 行最大值的初值取 -inf。赛题 3.7 明确要求不得初始化为 0——当某行全部为
 * 负数时，初值为 0 会得出错误的最大值 0。此处用 float 的有限最小值近似，
 * 因为设备侧写 -inf 需要额外的位操作；对本题输入范围（|值| < 1）等价。
 * ============================================================================
 */

#include <cmath>
#include "kernel_operator.h"

namespace {

/* 与 main.asc 中 TensorInfo.dtype 的编码一致 */
constexpr int32_t kDtypeFp16 = 1;
constexpr int32_t kDtypeBf16 = 2;

/* 行最大值初值。见文件头"数值约定"。 */
constexpr float kNegInf = -3.0e38f;

/* ------------------------------------------------------ 形状解析（host 侧） */

struct Dims {
    int32_t B, M, N, K;
    bool ok;
};

/* 按 transpose 标志从 storage shape 反推逻辑维度。
 * 规则见 docs/design/01_operator_interface.md §3。 */
Dims ResolveDims(const TensorGroupInfo& info_x1, const TensorGroupInfo& info_x2,
                 bool transposeX1, bool transposeX2)
{
    Dims d{0, 0, 0, 0, false};
    if (info_x1.tensors == nullptr || info_x2.tensors == nullptr) { return d; }
    if (info_x1.numTensors != 1 || info_x2.numTensors != 1) { return d; }
    if (info_x1.tensors[0].numDims != 3 || info_x2.tensors[0].numDims != 3) { return d; }

    const int64_t* s1 = info_x1.tensors[0].shape;
    const int64_t* s2 = info_x2.tensors[0].shape;

    d.B = static_cast<int32_t>(s1[0]);
    d.M = static_cast<int32_t>(transposeX1 ? s1[2] : s1[1]);
    const int32_t ka = static_cast<int32_t>(transposeX1 ? s1[1] : s1[2]);
    const int32_t kb = static_cast<int32_t>(transposeX2 ? s2[2] : s2[1]);
    d.N = static_cast<int32_t>(transposeX2 ? s2[1] : s2[2]);

    /* 逻辑 K 由两侧共同约束，必须相等（赛题 3.4 不允许 batch broadcast，
     * 且 x1/x2 的 B 与 K 分别相等）。 */
    d.K = ka;
    d.ok = (d.B > 0 && d.M > 0 && d.N > 0 && d.K > 0 && ka == kb);
    return d;
}

/*
 * bf16 -> fp32。
 *
 * bfloat16 是 1+8+7 位，与 fp32 的 1+8+23 位只差尾数宽度，
 * 故解码只需左移 16 位（低位补 0）。
 *
 * **注意与 fp16 的区别**：fp16 是 1+5+10 位，需要重算指数偏置，
 * 两者绝不可混用同一套位拆分。本项目曾把 bf16 当 fp16 处理，
 * 导致平台上 bf16 用例全部 Wrong Answer（本地因缺 bf16 测试而漏掉）。
 */
__aicore__ inline float Bf16ToFloat(uint16_t raw)
{
    /* 用 union 做位重解释：不依赖 __builtin_memcpy 在设备侧的可用性 */
    union { uint32_t u; float f; } conv;
    conv.u = static_cast<uint32_t>(raw) << 16;
    return conv.f;
}

/* 统一取数：按 dtype 解码成 fp32。所有读取都必须经过它，
 * 否则会重蹈"bf16 被当 fp16 读"的覆辙。 */
__aicore__ inline float ReadElem(const AscendC::GlobalTensor<half>& gh,
                                 const AscendC::GlobalTensor<float>& gf,
                                 int64_t idx, bool bf16In, bool fp16In)
{
    if (bf16In) {
        return Bf16ToFloat(reinterpret_cast<const __gm__ uint16_t*>(
            gh.GetPhyAddr())[idx]);
    }
    if (fp16In) {
        return static_cast<float>(gh.GetValue(static_cast<uint32_t>(idx)));
    }
    return gf.GetValue(static_cast<uint32_t>(idx));
}

/* 元素 (b,i,j) 在 x1 storage 里的一维下标。
 * **必须标 __aicore__**：它被 __global__ kernel 调用，而 Ascend C 编译器
 * 区分宿主/设备侧——未标注的函数默认是宿主函数，设备代码调用会编译失败
 * （实测报错 "call to [host] function from __global__ [aicore] function"）。
 * transposeX1=false 时 storage 是 (B,M,K)，元素为 (b,m,k)；
 * transposeX1=true  时 storage 是 (B,K,M)，元素为 (b,k,m)。 */
__aicore__ inline int64_t X1Index(int32_t B, int32_t M, int32_t K, bool tX1,
                       int32_t b, int32_t m, int32_t k)
{
    (void)B;
    return tX1 ? (static_cast<int64_t>(b) * K * M + static_cast<int64_t>(k) * M + m)
               : (static_cast<int64_t>(b) * M * K + static_cast<int64_t>(m) * K + k);
}

/* 元素 (b,k,n) 在 x2 storage 里的一维下标。同上，必须标 __aicore__。
 * transposeX2=false 时 storage 是 (B,K,N)，元素为 (b,k,n)；
 * transposeX2=true  时 storage 是 (B,N,K)，元素为 (b,n,k)。 */
__aicore__ inline int64_t X2Index(int32_t B, int32_t N, int32_t K, bool tX2,
                       int32_t b, int32_t k, int32_t n)
{
    (void)B;
    return tX2 ? (static_cast<int64_t>(b) * N * K + static_cast<int64_t>(n) * K + k)
               : (static_cast<int64_t>(b) * K * N + static_cast<int64_t>(k) * N + n);
}

/* ------------------------------------------------------ 设备侧 kernel */

/*
 * 纯向量、**按列分块并复用 x2** 的实现。参数全为数值，无结构体、无指针。
 *
 * ## 为什么这样组织循环（性能关键）
 *
 * 上一版按 (m, n, k) 三层循环，每个点积都重新读 x1 与 x2，共
 * B*M*N*K*2 次标量 GM 访问——large_square 达 21 亿次，实测 9.9 秒。
 *
 * 关键观察：**同一列 n 的所有行 m 复用同一段 x2[n][:]**。故改为
 * (n, m, k) 顺序，并把该列 x2 载入 UB 后复用：
 *
 *   - x2 的 GM 读取降到 B*N*K 次（每列一次）
 *   - x1 的 GM 读取为 B*M*K 次
 *   - 合计约 B*(M+N)*K 次，比原来少 M 倍（large_square 少 1024 倍）
 *
 * 内层仍是标量乘加，但操作数已在 UB，速度远高于 GM。
 *
 * ## 数值语义
 *
 * 点积按 k 顺序累加、行最大值对每列增量比较、最后沿 M 求和——
 * 与赛题"先沿 N 取最大、再沿 M 求和"的顺序一致，且与标量参考实现
 * 逐位相同（不使用向量归约，故无归约顺序差异）。
 */
__global__ __vector__ void batch_matmul_max_sum_custom(
    __gm__ uint8_t* x1, __gm__ uint8_t* x2, __gm__ uint8_t* y,
    int32_t B, int32_t M, int32_t N, int32_t K,
    int32_t transX1, int32_t transX2, int32_t dtypeCode)
{
    const int32_t numCores = static_cast<int32_t>(AscendC::GetBlockNum());
    const int32_t coreId = static_cast<int32_t>(AscendC::GetBlockIdx());

    /* === 工作分配：(batch, m 区间) 扁平切分 ===
     *
     * 赛题 3.5 性能要求明确：**沿 B 维和/或 M 维合理分配多核任务**，兼顾
     * 较小 Batch。原实现只按 B 维分配，并行度上限 min(B, 核数)；B 小则大量
     * 核空闲。这里把 (batch, m 区间) 展平成 B*mSplits 个工作单元，每核取
     * 连续一段，并行度上限提升到 min(B*mSplits, 核数)。
     *
     * 归约安全：每个 (b, m) 只属于一个工作单元、只被一个核处理，故每核算出
     * 的"行最大值之和"是正确的部分和；跨核归约由第二个 kernel 完成，其求和
     * 顺序固定（u = 0..workUnits-1 步长 B），故结果与核数、调度无关。 */
    const int32_t wsFloats = 1024;     /* workspace 容量（float） */
    int32_t mSplits = 1;
    if (numCores > B) {
        mSplits = (numCores + B - 1) / B;
        if (mSplits > M) { mSplits = M; }
        if (mSplits * B > wsFloats) { mSplits = wsFloats / B; }
        if (mSplits < 1) { mSplits = 1; }
    }
    const int32_t workUnits = B * mSplits;

    int32_t myUnitBegin = 0, myUnitEnd = 0;
    {
        const int32_t base = workUnits / numCores;
        const int32_t rem = workUnits % numCores;
        myUnitBegin = coreId * base + ((coreId < rem) ? coreId : rem);
        myUnitEnd = myUnitBegin + base + ((coreId < rem) ? 1 : 0);
    }
    if (myUnitBegin >= myUnitEnd) {
        return;                        /* 该核无活 */
    }

    /* workspace 置于 x2 缓冲区尾部（见下方注释）。 */
    __gm__ float* ws = reinterpret_cast<__gm__ float*>(
        reinterpret_cast<__gm__ uint8_t*>(x2)
        + static_cast<int64_t>(B) * N * K * 2 - wsFloats * 4);

    const bool tX1 = (transX1 != 0);
    const bool tX2 = (transX2 != 0);
    const bool bf16In = (dtypeCode == 2);      /* 1=fp16, 2=bf16（见 main.asc 的 dtype 编码） */
    const bool fp16In = (dtypeCode == 1);

    /* UB 缓冲：x2 一列（供 M 行复用）+ 每行当前最大值 + 写回暂存。
     * x1 不占缓冲：它按 k 逐个取值，取值后立即参与乘加，无需驻留。 */
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> colBuf, maxBuf;
    /* 容量按赛题维度上限取：
     *   colBuf 需容纳 x2 的一整列 -> K 上限 8192 个 float = 32KB
     *   maxBuf 需容纳每个行最大值 -> M 上限 8192 个 float = 32KB
     * maxBuf 早先只给 16KB（4096 个 float），M > 4096 时越界报错；且
     * bmk_limit(2^26) 不构成保护（B=4/K=256 时它允许 M 到 65536，远超
     * m_max=8192），故 M 取到 8192 完全合法。 */
    pipe.InitBuffer(colBuf, 32 * 1024);
    pipe.InitBuffer(maxBuf, 32 * 1024);
    AscendC::LocalTensor<half> colH = colBuf.Get<half>();
    AscendC::LocalTensor<float> colF = colBuf.Get<float>();
    AscendC::LocalTensor<float> rowMaxBuf = maxBuf.Get<float>();

    AscendC::GlobalTensor<half> g1H, g2H;
    AscendC::GlobalTensor<float> g1F, g2F;
    const int64_t numX1 = static_cast<int64_t>(B) * M * K;
    const int64_t numX2 = static_cast<int64_t>(B) * N * K;
    if (fp16In) {
        g1H.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1), static_cast<uint32_t>(numX1));
        g2H.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2), static_cast<uint32_t>(numX2));
    } else {
        g1F.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x1), static_cast<uint32_t>(numX1));
        g2F.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x2), static_cast<uint32_t>(numX2));
    }

    for (int32_t u = myUnitBegin; u < myUnitEnd; ++u) {
        const int32_t b = u / mSplits;
        const int32_t split = u % mSplits;
        /* 本单元负责的行区间 [mBegin, mEnd) */
        const int32_t mPer = M / mSplits;
        const int32_t mRem = M % mSplits;
        const int32_t mBegin = split * mPer + ((split < mRem) ? split : mRem);
        const int32_t mEnd = mBegin + mPer + ((split < mRem) ? 1 : 0);
        if (mBegin >= mEnd) { continue; }
        const int32_t rowsHere = mEnd - mBegin;

        /* 只为本区间的行初始化最大值（-inf，赛题 3.7） */
        for (int32_t i = 0; i < rowsHere; ++i) {
            rowMaxBuf.SetValue(static_cast<uint64_t>(i), kNegInf);
        }

        /* 沿 N 逐列（**列在外层**，使该列 x2 在 UB 中复用 M 次） */
        for (int32_t n = 0; n < N; ++n) {
            /* 载入 x2 第 n 列的全部 K 个值到 UB。
             * 列首 = 逻辑 (b, k=0, n) 的位置；两种 storage 布局下步长不同：
             *   transposeX2=false 时 storage 是 (B,K,N) -> 逻辑 (b,0,n) = b*K*N + n，步长 N
             *   transposeX2=true  时 storage 是 (B,N,K) -> 逻辑 (b,0,n) = b*N*K + n*K，步长 1
             * 前者的列在内存里不连续，只能用 GetValue 逐个取。 */
            const int64_t colBase = tX2
                ? (static_cast<int64_t>(b) * N * K + static_cast<int64_t>(n) * K)
                : (static_cast<int64_t>(b) * K * N + n);
            const int64_t colStep = tX2 ? 1 : N;
            /* 逐个取值。不用 DataCopy 载入：GM 起始偏移需 32 字节对齐，
             * 而列首地址在 (B,K,N) 布局下不满足（实测踩过，整列取值错位）。 */
            for (int32_t k = 0; k < K; ++k) {
                const int64_t idx = colBase + static_cast<int64_t>(k) * colStep;
                colF.SetValue(static_cast<uint64_t>(k),
                              ReadElem(g2H, g2F, idx, bf16In, fp16In));
            }

            /* 对每一行 m 计算与该列的点积，并增量更新行最大值。
             *
             * dtype 分派**提到 m 循环之外**：原先 `fp16In` 判断在 m 循环内，
             * 每个 (b,n,m) 判一次（约 2.1e9 次），且两个分支代码完全相同。
             * 现按 dtype 在循环外分派一次，内层只留纯计算。 */
            if (fp16In || bf16In) {
                if (bf16In) {
                    for (int32_t i = 0; i < rowsHere; ++i) {
                        const int32_t m = mBegin + i;
                        const int64_t x1Base = X1Index(B, M, K, tX1, b, m, 0);
                        const int64_t kStep = tX1 ? M : 1;
                        float dot = 0.0f;
                        int64_t idx = x1Base;
                        for (int32_t k = 0; k < K; ++k) {
                            dot += ReadElem(g1H, g1F, idx, true, false) *
                                   colF.GetValue(static_cast<uint64_t>(k));
                            idx += kStep;
                        }
                        if (dot > rowMaxBuf.GetValue(static_cast<uint64_t>(i))) {
                            rowMaxBuf.SetValue(static_cast<uint64_t>(i), dot);
                        }
                    }
                } else {
                    for (int32_t i = 0; i < rowsHere; ++i) {
                        const int32_t m = mBegin + i;
                        const int64_t x1Base = X1Index(B, M, K, tX1, b, m, 0);
                        const int64_t kStep = tX1 ? M : 1;
                        float dot = 0.0f;
                        int64_t idx = x1Base;
                        for (int32_t k = 0; k < K; ++k) {
                            dot += ReadElem(g1H, g1F, idx, false, true) *
                                   colF.GetValue(static_cast<uint64_t>(k));
                            idx += kStep;
                        }
                        if (dot > rowMaxBuf.GetValue(static_cast<uint64_t>(i))) {
                            rowMaxBuf.SetValue(static_cast<uint64_t>(i), dot);
                        }
                    }
                }
            } else {
                for (int32_t i = 0; i < rowsHere; ++i) {
                    const int32_t m = mBegin + i;
                    const int64_t x1Base = X1Index(B, M, K, tX1, b, m, 0);
                    const int64_t kStep = tX1 ? M : 1;
                    float dot = 0.0f;
                    int64_t idx = x1Base;
                    for (int32_t k = 0; k < K; ++k) {
                        dot += ReadElem(g1H, g1F, idx, false, false) *
                               colF.GetValue(static_cast<uint64_t>(k));
                        idx += kStep;
                    }
                    if (dot > rowMaxBuf.GetValue(static_cast<uint64_t>(i))) {
                        rowMaxBuf.SetValue(static_cast<uint64_t>(i), dot);
                    }
                }
            }
        }

        /* Sum(本区间的行最大值) -> 作为部分和写入 workspace */
        float partial = 0.0f;
        for (int32_t i = 0; i < rowsHere; ++i) {
            partial += rowMaxBuf.GetValue(static_cast<uint64_t>(i));
        }
        ws[static_cast<int64_t>(u)] = partial;
    }
}

}  // namespace

/* 归约 kernel：把各核写入 workspace 的部分和累加进 y。
 *
 * 为什么需要第二个 kernel：跨核归约需要原子操作或跨核同步，而
 * `AscendC::AtomicAdd` 仅支持 __NPU_ARCH__ 5102/3510（本项目是 2201）。
 * 用第二个 kernel 则两者都不需要——同一 stream 上顺序执行，主 kernel
 * 写完后归约 kernel 才读。
 *
 * 求和顺序固定（对每个 b 按 u 递增），故结果与核数、调度无关。 */
__global__ __vector__ void bmms_finalize(__gm__ uint8_t* x2, __gm__ uint8_t* y,
                                         int32_t B, int32_t N, int32_t K,
                                         int32_t mSplits)
{
    const int32_t wsFloats = 1024;
    const __gm__ float* ws = reinterpret_cast<const __gm__ float*>(
        reinterpret_cast<const __gm__ uint8_t*>(x2)
        + static_cast<int64_t>(B) * N * K * 2 - wsFloats * 4);
    __gm__ float* yOut = reinterpret_cast<__gm__ float*>(y);
    /* 该 kernel 只启动 1 个核；workspace 布局为 u = b*mSplits + split */
    for (int32_t b = 0; b < B; ++b) {
        float acc = 0.0f;
        for (int32_t sp = 0; sp < mSplits; ++sp) {
            acc += ws[static_cast<int64_t>(b) * mSplits + sp];
        }
        yOut[b] = acc;
    }
}

/* ------------------------------------------------------ 唯一契约入口 */

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y,  const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1,
                           bool transposeX2)
{
    (void)info_y;
    if (info_x1.tensors == nullptr || info_x2.tensors == nullptr) { return; }

    const int32_t dtypeCode = info_x1.tensors[0].dtype;
    if (dtypeCode != kDtypeFp16 && dtypeCode != kDtypeBf16) { return; }

    const Dims d = ResolveDims(info_x1, info_x2, transposeX1, transposeX2);
    if (!d.ok) { return; }

    const int32_t wsFloats = 1024;
    int32_t mSplits = 1;
    const int32_t avail = static_cast<int32_t>(availableCoreNum);
    if (avail > d.B) {
        mSplits = (avail + d.B - 1) / d.B;
        if (mSplits > d.M) { mSplits = d.M; }
        if (mSplits * d.B > wsFloats) { mSplits = wsFloats / d.B; }
        if (mSplits < 1) { mSplits = 1; }
    }
    const int32_t workUnits = d.B * mSplits;

    int32_t usedCores = avail;
    if (usedCores <= 0) { usedCores = 1; }
    if (usedCores > workUnits) { usedCores = workUnits; }

    /* 参数全为数值：device kernel 不解引用任何宿主指针（硬约束 1）。
     *
     * 启动方式分两种：生产环境用 kernel launch 语法；本机 CPU 调试模式（定义了
     * ASCENDC_CPU_DEBUG）必须改用 ICPU_RUN_KF 宏 —— 官方文档
     * docs/api/context/ICPU_RUN_KF.md 明确说明 <<<>>> 在 CPU 模式下不适用。
     * 二者参数一致，故此处只切换调用形式。 */
#ifdef ASCENDC_CPU_DEBUG
    ICPU_RUN_KF(batch_matmul_max_sum_custom, usedCores,
                x1, x2, y, d.B, d.M, d.N, d.K,
                transposeX1 ? 1 : 0, transposeX2 ? 1 : 0, dtypeCode);
    ICPU_RUN_KF(bmms_finalize, 1, x2, y, d.B, d.N, d.K, mSplits);
    (void)stream;
#else
    batch_matmul_max_sum_custom<<<usedCores, 0, stream>>>(
        x1, x2, y, d.B, d.M, d.N, d.K,
        transposeX1 ? 1 : 0, transposeX2 ? 1 : 0, dtypeCode);
    bmms_finalize<<<1, 0, stream>>>(x2, y, d.B, d.N, d.K, mSplits);
#endif
}
